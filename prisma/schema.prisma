generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         UserRole  @default(USER)
  emailVerifiedAt DateTime?
  avatarUrl    String?
  bio          String?   @db.VarChar(280)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  posts        Post[]
  comments     Comment[]
  likes        Like[]
  following    Follow[] @relation("UserFollowing")
  followers    Follow[] @relation("UserFollowers")
  createdGroups Group[] @relation("GroupCreator")
  groupMemberships GroupMember[]
  createdPages Page[] @relation("PageCreator")
  pageFollows PageFollower[]
  createdPolls Poll[]
  pollVotes PollVote[]
  createdEvents Event[] @relation("EventCreator")
  eventAttendances EventAttendee[]

  @@index([createdAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}


model Post {
  id        String   @id @default(cuid())
  authorId  String
  content   String   @db.VarChar(5000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments  Comment[]
  likes     Like[]

  @@index([createdAt])
  @@index([authorId, createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  content   String   @db.VarChar(2000)
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([authorId])
}

model Like {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId, createdAt])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}


model Group {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(80)
  slug        String   @unique
  description String   @db.VarChar(1000)
  privacy     String   @default("PUBLIC") @db.VarChar(12)
  creatorId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  creator     User     @relation("GroupCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  members     GroupMember[]
  @@index([createdAt])
}

model GroupMember {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  role      String   @default("MEMBER") @db.VarChar(12)
  joinedAt  DateTime @default(now())
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([groupId, userId])
  @@index([userId])
}

model Page {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(80)
  slug        String   @unique
  description String   @db.VarChar(1000)
  category    String   @db.VarChar(40)
  creatorId   String
  createdAt   DateTime @default(now())
  creator     User     @relation("PageCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  followers   PageFollower[]
  @@index([createdAt])
}

model PageFollower {
  id        String   @id @default(cuid())
  pageId    String
  userId    String
  followedAt DateTime @default(now())
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([pageId, userId])
  @@index([userId])
}

model Poll {
  id        String   @id @default(cuid())
  question  String   @db.VarChar(300)
  creatorId String
  createdAt DateTime @default(now())
  creator   User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  options   PollOption[]
  @@index([createdAt])
}

model PollOption {
  id     String @id @default(cuid())
  pollId String
  text   String @db.VarChar(120)
  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes  PollVote[]
  @@index([pollId])
}

model PollVote {
  id        String   @id @default(cuid())
  optionId  String
  userId    String
  createdAt DateTime @default(now())
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([optionId, userId])
  @@index([userId])
}

model Event {
  id          String   @id @default(cuid())
  title       String   @db.VarChar(120)
  description String   @db.VarChar(2000)
  location    String   @db.VarChar(200)
  startsAt    DateTime
  creatorId   String
  createdAt   DateTime @default(now())
  creator     User     @relation("EventCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  attendees   EventAttendee[]
  @@index([startsAt])
  @@index([creatorId])
}

model EventAttendee {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  status    String   @default("GOING") @db.VarChar(12)
  joinedAt  DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([eventId, userId])
  @@index([userId])
}
